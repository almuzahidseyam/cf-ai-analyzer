# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYZE_API_KEY=
GEMINI_API_KEY=
# An available Gemini model ID for your account. No default model is assumed.
GEMINI_MODEL=
# Must live on persistent writable storage, shared by workers on the same host.
ANALYZE_DB_PATH=./data/usage.sqlite
ANALYZE_DAILY_LIMIT=10
